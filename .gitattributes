# Treat trace/data files as binary so git doesn't try to diff them
*.trs binary
*.npy binary
*.npz binary
# If you decide to commit sample traces, route them through Git LFS instead:
# (uncomment after running `git lfs install` and `git lfs track "*.trs"` etc.)
# *.trs filter=lfs diff=lfs merge=lfs -text
# *.npy filter=lfs diff=lfs merge=lfs -text
# Keep notebook diffs clean line-by-line
*.ipynb text eol=lf
data/processed/*.npz filter=lfs diff=lfs merge=lfs -text
